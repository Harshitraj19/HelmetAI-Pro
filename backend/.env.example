# Copy to backend/.env (git-ignored). NEVER commit real keys - the base repo leaked a Roboflow key this way.
# MODEL_STACK=../models/helmet_unified.onnx
# IMG_SIZE=640
# CAMERA_ID=VIT-GATE-1
# ADMIN_TOKEN=change-me            # protects delete / training / reload endpoints
# CORS_ORIGINS=http://localhost:5173
# PUBLIC_URL=http://localhost:8000
# MAX_FRAME_WIDTH=1280             # downscale wider videos/streams before processing (0 = never)
# ORT_THREADS=0                    # ONNX Runtime threads per model (0 = auto, physical cores)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional Roboflow hosted model (add  roboflow  to MODEL_STACK):
# ROBOFLOW_API_KEY=
# ROBOFLOW_WORKSPACE=
# ROBOFLOW_WORKFLOW_ID=
